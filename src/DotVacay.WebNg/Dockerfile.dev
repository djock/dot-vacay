FROM node:20-alpine

WORKDIR /app

# Create non-root user first
RUN addgroup -g 1001 appuser && \
    adduser -D -u 1001 -G appuser appuser

# Copy package files
COPY package*.json ./

# Install dependencies as root
RUN npm ci && chown -R appuser:appuser node_modules package-lock.json

# Ensure node_modules/.bin is in PATH
ENV PATH=/app/node_modules/.bin:$PATH

# Copy source code (chown to appuser)
COPY --chown=appuser:appuser . .

USER appuser

# Expose port
EXPOSE 50316

# Start development server
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "50316"]
