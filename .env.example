# JWT Configuration (generate a strong key)
DOTVACAY_JWT_KEY=your-super-secret-jwt-key-at-least-256-bits-long
DOTVACAY_JWT_ISSUER=https://localhost:5111
DOTVACAY_JWT_AUDIENCE=https://localhost:5111
DOTVACAY_JWT_EXPIREDAYS=30

# CORS Origins
DOTVACAY_CORS_ORIGINS=http://localhost:50316,https://localhost:50316,http://frontend:50316,https://frontend:50316

# Database (SQLite file path in container)
DOTVACAY_DB_PATH=/app/data/dotvacay.db

# OpenAI API Key (optional - AI features currently disabled)
# DOTVACAY_OPENAI_APIKEY=your-openai-api-key-here

# Connection String (optional - defaults to DOTVACAY_DB_PATH if not set)
DOTVACAY_CONNECTION_STRING=Data Source=/app/data/dotvacay.db
